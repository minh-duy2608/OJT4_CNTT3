# ==============================================================================
# Environment Variables for Fullstack Docker Compose
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# MySQL Configuration (Mặc định 3307 để tránh trùng nếu máy đã cài MySQL 3306)
MYSQL_ROOT_PASSWORD=root_secure_password_123
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password_123
MYSQL_PORT=3307

# PhpMyAdmin Port (Web UI for MySQL)
PMA_PORT=8085

# Backend Configuration (Spring Boot)
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Frontend Configuration (React Vite + Nginx)
FRONTEND_PORT=3000
